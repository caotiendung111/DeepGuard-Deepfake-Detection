# DeepGuard Environment Variables
# Copy this file to .env and fill in your values

# === Model Configuration ===
MODEL_BACKBONE=efficientnet_b4   # efficientnet_b4 | xception
MODEL_CHECKPOINT_PATH=models/checkpoints/best_model.pth
DEVICE=cuda                       # cuda | cpu

# === API Configuration ===
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4
MAX_UPLOAD_SIZE_MB=100

# === MLflow Tracking ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=deepguard-experiments

# === Data Paths ===
DATA_ROOT=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# === Training ===
BATCH_SIZE=32
NUM_EPOCHS=30
LEARNING_RATE=1e-4
NUM_WORKERS=4

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/deepguard.log
