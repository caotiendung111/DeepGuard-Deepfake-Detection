# ============================================================
# DeepGuard — Dockerfile (GPU / CUDA 11.8)
# ============================================================
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Install Python
RUN apt-get update && apt-get install -y \
    python3.10 python3.10-dev python3-pip \
    libglib2.0-0 libsm6 libxext6 libxrender-dev \
    libgomp1 ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN ln -sf python3.10 /usr/bin/python && ln -sf pip3 /usr/bin/pip

WORKDIR /app

# Install PyTorch with CUDA
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cu118 && \
    pip install --no-cache-dir -r requirements.txt

# Copy project
COPY src/ ./src/
COPY api/ ./api/
COPY app/ ./app/
COPY configs/ ./configs/
COPY setup.py .

RUN pip install -e . --no-deps

RUN mkdir -p models/checkpoints data/raw data/processed logs

EXPOSE 8000 7860 8501

ENV PYTHONPATH=/app
ENV MODEL_BACKBONE=efficientnet_b4
ENV DEVICE=cuda
ENV API_HOST=0.0.0.0
ENV API_PORT=8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
